#!name=出口 IP 检测
#!desc=强制检测所选 Egern 策略组的 IPv4 出口、ASN 与纯净度
#!author=Codex
#!arguments=Proxy:DIRECT,MarkIP:false
#!arguments-desc=Proxy: 选择要检测的策略组，默认 DIRECT。@MarkIP: 是否隐藏部分 IP（true/false）。

[Rule]
DOMAIN,ipv4.ippubblico.org,{{{Proxy}}}
DOMAIN,reputation.noc.org,{{{Proxy}}}

[Panel]
出口 IP 检测 = script-name=出口 IP 检测, title=出口 IP 检测, content=刷新中…, style=info, update-interval=300

[Script]
出口 IP 检测 = type=generic, timeout=20, argument={{{MarkIP}}}, script-path=https://raw.githubusercontent.com/DeraDream/egern-modules/main/ip-exit-panel.js?v=4
